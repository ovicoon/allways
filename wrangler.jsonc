{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edufinhub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",

  // 정적 파일 (로고 등). public/ 에 있는 파일은 Worker 실행 없이 바로 제공됨 (예: /allways.svg)
  "assets": { "directory": "./public/" },

  // 같은 계정의 Worker를 workers.dev URL로 fetch하면 Error 1042 가 나므로 Service Binding 사용
  // "remote": true → wrangler dev 에서도 로컬 시뮬레이션이 아닌 배포된 ai-api-hub 에 연결 (deploy 와 동일 동작)
  "services": [
    { "binding": "BACKEND", "service": "ai-api-hub", "remote": true }
  ]

  // 시크릿 (백엔드에 설정된 BACKEND_API_KEY 와 같은 값):
  //   배포:  npx wrangler secret put BACKEND_API_KEY
  //   로컬:  .dev.vars 파일에  BACKEND_API_KEY=값
}
